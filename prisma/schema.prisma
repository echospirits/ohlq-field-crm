generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  LIQUOR_AGENCY
  BAR_RESTAURANT
  CHAIN_GROUP
  OTHER
}

enum AlertStatus {
  OPEN
  SNOOZED
  DISMISSED
  RESOLVED
}

enum PhotoType {
  SHELF
  DISPLAY
  MENU
  BACK_BAR
  COMPETITOR
  OTHER
}

enum EventSource {
  MANUAL
  EVENTBRITE
  GOOGLE_SHEET
}

enum WorklistStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorklistSource {
  MANUAL
  VISIT_FOLLOW_UP
  OHLQ_WHOLESALE_REACTIVATION
  TARGET_ACCOUNT_INTELLIGENCE
  OPPORTUNITY_INTELLIGENCE
  AGENCY_INTELLIGENCE
}

enum OpportunityType {
  LAPSED_BUYER
  FIRST_ORDER_FOLLOW_UP
  CATEGORY_CONQUEST
  CROSS_SELL
  NO_RECENT_TOUCH
}

enum OpportunityStatus {
  OPEN
  ACTIONED
  SNOOZED
  DISMISSED
  CONVERTED
  RESOLVED
  EXPIRED
}

enum OpportunityEventType {
  DETECTED
  SHOWN
  ASSIGNED
  WORKLIST_CREATED
  OPENED
  VISIT_LOGGED
  ACTIONED
  SNOOZED
  DISMISSED
  PURCHASE_DETECTED
  CONVERTED
  RESOLVED
  EXPIRED
  TASK_COMPLETED
  TASK_REASSIGNED
}

enum OpportunityRankingMode {
  ACTIVE
  SHADOW
}

enum AgencyInventoryState {
  HEALTHY
  STOCKOUT
  UNDERSTOCKED
  DEAD_INVENTORY
  MISSING_PLACEMENT
  AT_RISK
  INSUFFICIENT_DATA
}

enum AgencyProductOpportunityState {
  WINNING
  MAINTAIN
  RESTOCK
  STOCKOUT
  PLACEMENT_OPPORTUNITY
  ACTIVATION_OPPORTUNITY
  AT_RISK
  DEAD_INVENTORY
  LOW_PRIORITY
  INSUFFICIENT_EVIDENCE
}

enum AgencyRecommendedAction {
  MAINTAIN
  RESTOCK
  PURSUE_PLACEMENT
  SCHEDULE_TASTING
  INVESTIGATE
  REDUCE_PRIORITY
  MONITOR
  NO_ACTION
}

enum AgencyIntelligenceBand {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT_DATA
}

enum WorklistCategory {
  AGENCY
  WHOLESALE
  GENERAL
}

enum UserRole {
  PLATFORM_ADMIN
  ADMIN
  TASTER
  USER
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum OrganizationOnboardingStatus {
  PROVISIONING
  READY
  NEEDS_ATTENTION
}

enum OrganizationProductStatus {
  OWNED
  EXCLUDED
  REPRESENTED
}

enum OrganizationAuditAction {
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_ENABLED
  ORGANIZATION_DISABLED
  FEATURE_CHANGED
  VENDOR_IDENTIFIER_ADDED
  VENDOR_IDENTIFIER_REMOVED
  PRODUCT_CONFIGURATION_CHANGED
  INITIAL_ADMIN_CREATED
  SUPPORT_VIEW_STARTED
  SUPPORT_VIEW_ENDED
}

enum GeocodeStatus {
  PENDING
  SUCCESS
  FAILED
}

enum CalendarProviderName {
  GOOGLE
  MICROSOFT
  APPLE
}

enum CalendarSyncStatus {
  PENDING
  SYNCED
  ERROR
  REMOVED
  DISABLED
}

enum WeeklyDigestType {
  USER_WEEKLY
  ADMIN_WEEKLY
}

enum WeeklyDigestStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum MenuPlacementType {
  COCKTAIL_MENU
  MENU_FEATURE
  HAPPY_HOUR
  TABLE_TENT
  QR_DIGITAL
  BACK_BAR
  OTHER
}

enum MenuPlacementStatus {
  PROMISED
  LIVE
  PAUSED
  ENDED
  LOST
}

enum MenuPlacementSource {
  MANUAL
  VISIT
  PHOTO
  ACCOUNT_REVIEW
  IMPORT
}

enum OhlqReportDataSource {
  ANNUAL_SALES_SUMMARY
  ANNUAL_SALES_SUMMARY_BY_WHOLESALE
  AGENCY_INVENTORY_REPORT
}

enum OhlqReportRunStatus {
  RUNNING
  COMPLETED
  ERRORED
}

enum TargetImportStatus {
  DRY_RUN
  COMPLETED
  FAILED
}

enum TargetOpportunityType {
  NEW_PLACEMENT
  EXISTING_ACCOUNT_EXPANSION
  VELOCITY_IMPROVEMENT
  RETENTION_RISK
  RESEARCH_REQUIRED
  CHAIN_EXPANSION
}

enum TargetOpportunityStatus {
  OPEN
  IN_PROGRESS
  WON
  LOST
  DISMISSED
}

enum TargetPlacementStatus {
  UNKNOWN
  NOT_PLACED
  PLACED
}

model User {
  id                          String                 @id @default(cuid())
  organizationId              String?
  email                       String                 @unique
  firstName                   String?
  lastName                    String?
  name                        String?
  phone                       String?
  passwordHash                String?
  role                        UserRole               @default(USER)
  isActive                    Boolean                @default(true)
  image                       String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  sessions                    UserSession[]
  invitations                 UserInvitation[]
  createdWholesaleAccounts    WholesaleAccount[]     @relation("WholesaleAccountCreatedBy")
  mergedWholesaleAccounts     WholesaleAccount[]     @relation("WholesaleAccountMergedBy")
  createdLocationContacts     LocationContact[]      @relation("LocationContactCreatedBy")
  createdLoggedVisits         LoggedVisit[]          @relation("LoggedVisitCreatedBy")
  createdVisitPhotos          VisitPhoto[]           @relation("VisitPhotoCreatedBy")
  createdWorklistItems        WorklistItem[]         @relation("WorklistItemCreatedBy")
  createdTags                 Tag[]                  @relation("TagCreatedBy")
  createdLocationTags         LocationTag[]          @relation("LocationTagCreatedBy")
  createdRecipes              Recipe[]               @relation("RecipeCreatedBy")
  updatedRecipes              Recipe[]               @relation("RecipeUpdatedBy")
  createdRecipeSuggestions    RecipeSuggestion[]     @relation("RecipeSuggestionCreatedBy")
  assignedMenuPlacements      MenuPlacement[]        @relation("MenuPlacementAssignedTo")
  createdMenuPlacements       MenuPlacement[]        @relation("MenuPlacementCreatedBy")
  updatedMenuPlacements       MenuPlacement[]        @relation("MenuPlacementUpdatedBy")
  weeklyDigestLogs            WeeklyDigestLog[]      @relation("WeeklyDigestRecipient")
  assignedWorklistItems       WorklistItem[]         @relation("WorklistItemAssignedTo")
  completedWorklistItems      WorklistItem[]         @relation("WorklistItemCompletedBy")
  cancelledWorklistItems      WorklistItem[]         @relation("WorklistItemCancelledBy")
  assignedTargetProfiles      TargetAccountProfile[] @relation("TargetAccountAssignedTo")
  ownedTargetSkuOpportunities TargetSkuOpportunity[] @relation("TargetSkuOpportunityOwner")
  calendarConnections         CalendarConnection[]
  calendarOAuthStates         CalendarOAuthState[]
  followUpAssignedVisits      LoggedVisit[]          @relation("LoggedVisitFollowUpAssignedTo")

  @@index([role])
  @@index([organizationId])
  @@index([isActive])
}

model Organization {
  id                String                         @id @default(cuid())
  name              String
  displayName       String
  slug              String                         @unique
  active            Boolean                        @default(true)
  primaryState      String                         @default("OH")
  timezone          String                         @default("America/New_York")
  website           String?
  logoUrl           String?
  accountStatus     OrganizationStatus             @default(TRIAL)
  onboardingStatus  OrganizationOnboardingStatus   @default(PROVISIONING)
  onboardingData    Json                           @default("{}")
  notes             String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  vendorIdentifiers OrganizationVendorIdentifier[]
  products          OrganizationProduct[]
  features          OrganizationFeature[]
  accountOverlays   OrganizationAccountOverlay[]
  auditEvents       OrganizationAuditEvent[]

  @@index([active, accountStatus])
  @@index([onboardingStatus])
  @@index([createdAt])
}

model OrganizationVendorIdentifier {
  id             String       @id @default(cuid())
  organizationId String
  market         String       @default("OH")
  vendorId       String
  active         Boolean      @default(true)
  label          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, market, vendorId])
  @@index([market, vendorId])
}

model OrganizationProduct {
  id                String                    @id @default(cuid())
  organizationId    String
  market            String                    @default("OH")
  externalItemCode  String
  displayName       String?
  status            OrganizationProductStatus @default(OWNED)
  active            Boolean                   @default(true)
  category          String?
  subcategory       String?
  strategicPriority Int?
  discontinued      Boolean                   @default(false)
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, market, externalItemCode])
  @@index([market, externalItemCode])
  @@index([organizationId, status, active])
}

model OrganizationFeature {
  id             String       @id @default(cuid())
  organizationId String
  featureKey     String
  enabled        Boolean      @default(false)
  source         String       @default("override")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureKey])
  @@index([featureKey, enabled])
}

model OrganizationAccountOverlay {
  id                    String       @id @default(cuid())
  organizationId        String
  accountType           String
  externalAccountId     String
  active                Boolean      @default(true)
  targetStatus          String?
  assignedUserId        String?
  priority              String?
  notes                 String?
  customName            String?
  tags                  Json         @default("[]")
  relationshipStatus    String?
  opportunitySuppressed Boolean      @default(false)
  strategy              String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, accountType, externalAccountId])
  @@index([organizationId, active])
  @@index([assignedUserId])
}

model OrganizationAuditEvent {
  id             String                  @id @default(cuid())
  organizationId String?
  actorUserId    String
  action         OrganizationAuditAction
  metadata       Json?
  occurredAt     DateTime                @default(now())
  organization   Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
}

model CalendarConnection {
  id                     String                  @id @default(cuid())
  userId                 String
  provider               CalendarProviderName
  providerAccountId      String
  providerEmail          String?
  accessTokenEncrypted   String
  refreshTokenEncrypted  String?
  tokenExpiresAt         DateTime?
  scope                  String
  selectedCalendarId     String
  selectedCalendarName   String?
  syncEnabled            Boolean                 @default(true)
  syncToken              String?
  lastSyncAt             DateTime?
  syncError              String?
  requiresReconnect      Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  worklistCalendarEvents WorklistCalendarEvent[]

  @@unique([userId, provider])
  @@index([provider, providerAccountId])
  @@index([provider, syncEnabled, requiresReconnect])
}

model CalendarOAuthState {
  id         String               @id @default(cuid())
  userId     String
  provider   CalendarProviderName
  stateHash  String               @unique
  returnPath String?
  expiresAt  DateTime
  createdAt  DateTime             @default(now())
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([expiresAt])
}

model WeeklyDigestLog {
  id                String             @id @default(cuid())
  organizationId    String?
  digestType        WeeklyDigestType
  recipientUserId   String?
  recipientEmail    String
  periodStart       DateTime
  periodEnd         DateTime
  scheduledFor      DateTime
  runAt             DateTime?
  status            WeeklyDigestStatus @default(PENDING)
  attemptCount      Int                @default(0)
  providerMessageId String?
  errorMessage      String?
  lastSkippedAt     DateTime?
  lastSkipReason    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  recipientUser     User?              @relation("WeeklyDigestRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@unique([digestType, recipientEmail, periodStart, periodEnd])
  @@index([digestType])
  @@index([organizationId])
  @@index([recipientUserId])
  @@index([recipientEmail])
  @@index([periodStart, periodEnd])
  @@index([scheduledFor])
  @@index([status])
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserInvitation {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  acceptedAt        DateTime?
  providerMessageId String?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([acceptedAt])
}

model LoginThrottle {
  id            String    @id @default(cuid())
  identifier    String    @unique
  failedCount   Int       @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([lockedUntil])
}

model Account {
  id                  String            @id @default(cuid())
  externalId          String?           @unique
  agencyId            String?           @unique
  agencyRefId         String?
  licenseeId          String?           @unique
  type                AccountType
  name                String
  address             String?
  city                String?
  county              String?
  state               String?           @default("OH")
  zip                 String?
  phone               String?
  d8Permit            Boolean           @default(false)
  ownership           String?
  districtId          String?
  warehouse           String?
  orderDay            String?
  orderWeek           String?
  deliveryDay         String?
  primaryContact      String?
  primaryContactPhone String?
  wholesaleStatus     String?
  ownerUserId         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tags                AccountTag[]
  notes               Note[]
  photos              Photo[]
  tasks               Task[]
  alerts              Alert[]
  salesFacts          SalesFact[]
  inventoryFacts      InventoryFact[]
  visits              Visit[]
  menuPlacements      MenuPlacement[]
  officialWholesale   WholesaleAccount? @relation("OfficialWholesaleAccount")
}

model Sku {
  id             String          @id @default(cuid())
  itemCode       String          @unique
  brand          String?
  name           String
  category       String?
  active         Boolean         @default(true)
  recipes        Recipe[]
  salesFacts     SalesFact[]
  inventoryFacts InventoryFact[]
}

model Tag {
  id              String        @id @default(cuid())
  organizationId  String?
  name            String        @unique
  color           String?
  description     String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accounts        AccountTag[]
  locationTags    LocationTag[]
  createdByUser   User?         @relation("TagCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@index([organizationId])
}

model AccountTag {
  accountId String
  tagId     String
  reason    String?
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([accountId, tagId])
}

model SalesFact {
  id               String   @id @default(cuid())
  accountId        String
  skuId            String
  periodMonth      DateTime
  retailBottles    Int      @default(0)
  retailAmount     Decimal  @default(0)
  wholesaleBottles Int      @default(0)
  wholesaleAmount  Decimal  @default(0)
  account          Account  @relation(fields: [accountId], references: [id])
  sku              Sku      @relation(fields: [skuId], references: [id])

  @@unique([accountId, skuId, periodMonth])
}

model InventoryFact {
  id               String    @id @default(cuid())
  accountId        String
  skuId            String
  snapshotDate     DateTime  @default(now())
  coverageStatus   String?
  minFlag          Boolean   @default(false)
  inventoryBottles Int       @default(0)
  sales12MoBottles Int       @default(0)
  lastArrivalDate  DateTime?
  account          Account   @relation(fields: [accountId], references: [id])
  sku              Sku       @relation(fields: [skuId], references: [id])

  @@unique([accountId, skuId, snapshotDate])
}

model OhlqAnnualSalesRow {
  reportDate           DateTime @db.Date
  agencyId             String
  vendor               String
  brand                String
  retailBottlesSold    Int      @default(0)
  wholesaleBottlesSold Int      @default(0)

  @@id([reportDate, agencyId, vendor, brand])
  @@index([agencyId, vendor, reportDate, brand])
}

model OhlqAnnualSalesByWholesaleRow {
  reportDate           DateTime @db.Date
  agencyId             String
  vendor               String
  brand                String
  permitNumber         String
  wholesaleBottlesSold Int      @default(0)

  @@id([reportDate, agencyId, vendor, brand, permitNumber])
  @@index([permitNumber, reportDate])
  @@index([permitNumber, vendor, reportDate, brand])
}

model OhlqAgencyInventorySnapshot {
  snapshotDate          DateTime @db.Date
  agencyNumber          String
  itemCode              String
  agencyId              String?
  agencyName            String
  itemName              String
  status                String?
  detailCodeDescription String?
  coverageGroup         String?
  minimum               Int?
  onHand                Int?
  vendorId              String
  vendorName            String?
  brokerId              String?
  brokerName            String?
  district              String?
  importedAt            DateTime @default(now())
  agency                Agency?  @relation("AgencyInventorySnapshots", fields: [agencyId], references: [id], onDelete: SetNull)

  @@id([snapshotDate, agencyNumber, itemCode])
  @@index([agencyId, snapshotDate])
  @@index([agencyId, itemCode, snapshotDate])
  @@index([agencyNumber, snapshotDate])
  @@index([agencyNumber, itemCode, snapshotDate])
  @@index([itemCode, snapshotDate])
  @@index([snapshotDate])
  @@index([vendorId])
  @@index([status])
  @@index([onHand])
}

model OhlqAgencyInventoryCurrent {
  agencyNumber          String
  itemCode              String
  agencyId              String?
  agencyName            String
  itemName              String
  status                String?
  detailCodeDescription String?
  coverageGroup         String?
  minimum               Int?
  onHand                Int?
  vendorId              String
  vendorName            String?
  brokerId              String?
  brokerName            String?
  district              String?
  snapshotDate          DateTime @db.Date
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  agency                Agency?  @relation("AgencyInventoryCurrent", fields: [agencyId], references: [id], onDelete: SetNull)

  @@id([agencyNumber, itemCode])
  @@index([agencyId, itemCode])
  @@index([itemCode, onHand])
  @@index([snapshotDate])
  @@index([status])
  @@index([vendorId])
}

model OhlqBrandMasterItem {
  itemCode           String   @id
  name               String
  vendor             String?
  broker             String?
  category           String?
  purchaseUnitSymbol String?
  productVolume      Decimal?
  retailPrice        Decimal?
  wholesalePrice     Decimal?
  solItemStatusCode  String?
  bottleLimit        Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([name])
  @@index([vendor])
  @@index([category])
}

model OhlqReportImportStatus {
  id               String               @id @default(cuid())
  dataSource       OhlqReportDataSource
  reportDate       DateTime             @db.Date
  status           OhlqReportRunStatus
  rowCount         Int                  @default(0)
  parsedRows       Int                  @default(0)
  skippedRows      Int                  @default(0)
  replacedRows     Int                  @default(0)
  sizeBytes        Int                  @default(0)
  filename         String?
  startedAt        DateTime             @default(now())
  completedAt      DateTime?
  lastSuccessfulAt DateTime?
  errorMessage     String?
  diagnostics      Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([dataSource, reportDate])
  @@index([dataSource])
  @@index([reportDate])
  @@index([status])
  @@index([lastSuccessfulAt])
}

model Alert {
  id           String      @id @default(cuid())
  accountId    String
  skuId        String?
  type         String
  title        String
  detail       String?
  status       AlertStatus @default(OPEN)
  dueDate      DateTime?
  snoozedUntil DateTime?
  resolvedAt   DateTime?
  dismissedAt  DateTime?
  account      Account     @relation(fields: [accountId], references: [id])
  notes        Note[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  accountId String
  alertId   String?
  body      String
  createdBy String?
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id])
  alert     Alert?   @relation(fields: [alertId], references: [id])
}

model Task {
  id          String    @id @default(cuid())
  accountId   String
  title       String
  dueDate     DateTime?
  completedAt DateTime?
  ownerUserId String?
  account     Account   @relation(fields: [accountId], references: [id])
}

model Visit {
  id             String          @id @default(cuid())
  accountId      String
  visitDate      DateTime        @default(now())
  summary        String?
  createdBy      String?
  account        Account         @relation(fields: [accountId], references: [id])
  photos         Photo[]
  menuPlacements MenuPlacement[]
}

model Photo {
  id                 String         @id @default(cuid())
  accountId          String
  visitId            String?
  type               PhotoType
  url                String
  caption            String?
  takenAt            DateTime       @default(now())
  account            Account        @relation(fields: [accountId], references: [id])
  visit              Visit?         @relation(fields: [visitId], references: [id])
  menuPlacementProof MenuPlacement? @relation("MenuPlacementProofPhoto")
}

model MenuPlacement {
  id                 String              @id @default(cuid())
  organizationId     String?
  accountId          String
  wholesaleAccountId String?
  visitId            String?
  proofPhotoId       String?             @unique
  product            String
  menuItemName       String
  placementType      MenuPlacementType   @default(COCKTAIL_MENU)
  status             MenuPlacementStatus @default(PROMISED)
  source             MenuPlacementSource @default(MANUAL)
  proofUrl           String?
  proofStorageKey    String?
  proofContentType   String?
  proofSizeBytes     Int?
  firstSeenAt        DateTime?
  lastVerifiedAt     DateTime?
  expectedEndAt      DateTime?
  notes              String?
  assignedToUserId   String?
  createdByUserId    String?
  updatedByUserId    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  wholesaleAccount   WholesaleAccount?   @relation(fields: [wholesaleAccountId], references: [id], onDelete: SetNull)
  visit              Visit?              @relation(fields: [visitId], references: [id], onDelete: SetNull)
  proofPhoto         Photo?              @relation("MenuPlacementProofPhoto", fields: [proofPhotoId], references: [id], onDelete: SetNull)
  assignedToUser     User?               @relation("MenuPlacementAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdByUser      User?               @relation("MenuPlacementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser      User?               @relation("MenuPlacementUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([organizationId])
  @@index([wholesaleAccountId])
  @@index([status])
  @@index([placementType])
  @@index([source])
  @@index([firstSeenAt])
  @@index([lastVerifiedAt])
  @@index([expectedEndAt])
  @@index([assignedToUserId])
}

model EventShift {
  id             String      @id @default(cuid())
  source         EventSource @default(MANUAL)
  externalId     String?
  title          String
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  accountId      String?
  assignedUserId String?
  status         String      @default("open")
  createdAt      DateTime    @default(now())
}

model Recipe {
  id                String             @id @default(cuid())
  organizationId    String?
  name              String
  primarySpirit     String?
  preparation       String?
  glassware         String?
  sourceAttribution String?
  fitsNeed          String?
  complexity        String?
  recipeText        String             @default("")
