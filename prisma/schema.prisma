  linkedWholesaleCount          Int                    @default(0)
  activeWholesaleCount          Int                    @default(0)
  echoWholesaleBuyerCount       Int                    @default(0)
  wholesaleEchoBottles30        Int                    @default(0)
  lapsedWholesaleCount          Int                    @default(0)
  openWholesaleOpportunityCount Int                    @default(0)
  recommendedFocus              Json
  retailReasons                 Json
  wholesaleReasons              Json
  signalSnapshot                Json
  rulesVersion                  String
  scoringVersion                String
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  agency                        Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([retailBand, asOfDate])
  @@index([wholesaleInfluenceBand, asOfDate])
  @@index([stockoutCount])
  @@index([placementOpportunityCount])
  @@index([tastingOpportunityCount])
  @@index([deadInventoryCount])
}

model AgencyIntelligenceEvent {
  id                          String                         @id @default(cuid())
  organizationId              String?
  agencyId                    String
  agencyProductIntelligenceId String?
  itemCode                    String?
  eventType                   String
  eventKey                    String                         @unique
  previousInventoryState      AgencyInventoryState?
  inventoryState              AgencyInventoryState?
  previousOpportunityState    AgencyProductOpportunityState?
  opportunityState            AgencyProductOpportunityState?
  snapshot                    Json
  occurredAt                  DateTime
  createdAt                   DateTime                       @default(now())
  agency                      Agency                         @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, occurredAt])
  @@index([agencyProductIntelligenceId, occurredAt])
  @@index([itemCode, occurredAt])
  @@index([eventType, occurredAt])
}

model OpportunityAccountSignal {
  id                  String           @id @default(cuid())
  organizationId      String?
  wholesaleAccountId  String           @unique
  asOfDate            DateTime         @db.Date
  signalVersion       String
  features            Json
  firstEchoPurchaseAt DateTime?        @db.Date
  lastEchoPurchaseAt  DateTime?        @db.Date
  historyComplete     Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  wholesaleAccount    WholesaleAccount @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)

  @@index([asOfDate])
  @@index([lastEchoPurchaseAt])
}

model AccountSalesEvent {
  id                 String           @id @default(cuid())
  organizationId     String?
  wholesaleAccountId String
  reportDate         DateTime         @db.Date
  agencyId           String
  vendor             String
  itemCode           String
  itemName           String
  category           String?
  bottles            Int
  annualBottlesAfter Int
  isTenantProduct    Boolean
  sourceKey          String           @unique
  createdAt          DateTime         @default(now())
  wholesaleAccount   WholesaleAccount @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)

  @@index([wholesaleAccountId, reportDate])
  @@index([reportDate])
  @@index([vendor, reportDate])
  @@index([itemCode, reportDate])
  @@index([category, reportDate])
  @@index([isTenantProduct, reportDate])
}

model OpportunityModelVersion {
  id              String                 @id @default(cuid())
  name            String
  version         String
  opportunityType OpportunityType?
  mode            OpportunityRankingMode @default(ACTIVE)
  configuration   Json
  evaluation      Json?
  activatedAt     DateTime?
  retiredAt       DateTime?
  createdAt       DateTime               @default(now())
  scores          OpportunityScore[]

  @@unique([name, version, opportunityType, mode])
  @@index([opportunityType, mode, activatedAt])
}

model SalesOpportunity {
  id                   String             @id @default(cuid())
  organizationId       String?
  wholesaleAccountId   String
  type                 OpportunityType
  status               OpportunityStatus  @default(OPEN)
  activeAccountKey     String?            @unique
  cycleKey             String
  targetCategory       String?
  title                String
  recommendedAction    String
  explanation          Json
  signalSnapshot       Json
  rulesVersion         String
  scoringVersion       String
  productionScore      Float
  priorityBand         String
  assignedToUserId     String?
  detectedAt           DateTime
  lastDetectedAt       DateTime
  shownAt              DateTime?
  actionedAt           DateTime?
  snoozedUntil         DateTime?
  dismissedAt          DateTime?
  dismissalReason      String?
  convertedAt          DateTime?
  resolvedAt           DateTime?
  expiredAt            DateTime?
  conversionPurchaseAt DateTime?          @db.Date
  conversionVisitId    String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  wholesaleAccount     WholesaleAccount   @relation(fields: [wholesaleAccountId], references: [id], onDelete: Cascade)
  events               OpportunityEvent[]
  scores               OpportunityScore[]
  worklistItems        WorklistItem[]
  loggedVisits         LoggedVisit[]

  @@index([wholesaleAccountId, type, cycleKey])
  @@index([wholesaleAccountId, status])
  @@index([type, status, productionScore])
  @@index([status, detectedAt])
  @@index([assignedToUserId, status])
  @@index([scoringVersion])
}

model OpportunityEvent {
  id                 String               @id @default(cuid())
  organizationId     String?
  opportunityId      String
  eventType          OpportunityEventType
  eventKey           String
  wholesaleAccountId String
  userId             String?
  loggedVisitId      String?
  worklistItemId     String?
  purchaseReportDate DateTime?            @db.Date
  metadata           Json?
  occurredAt         DateTime
  createdAt          DateTime             @default(now())
  opportunity        SalesOpportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, eventKey])
  @@index([wholesaleAccountId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([userId, occurredAt])
  @@index([loggedVisitId])
  @@index([worklistItemId])
  @@index([purchaseReportDate])
}

model OpportunityScore {
  id             String                  @id @default(cuid())
  opportunityId  String
  modelVersionId String
  mode           OpportunityRankingMode
  score          Float
  priorityBand   String
  factors        Json
  scoredAt       DateTime                @default(now())
  opportunity    SalesOpportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  modelVersion   OpportunityModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, modelVersionId])
  @@index([mode, score])
  @@index([scoredAt])
}

model WorklistCalendarEvent {
  id              String               @id @default(cuid())
  worklistItemId  String
  connectionId    String?
  provider        CalendarProviderName
  externalEventId String?
  calendarId      String?
  syncStatus      CalendarSyncStatus   @default(PENDING)
  eventUpdatedAt  DateTime?
  eventEtag       String?
  crmScheduleHash String?
  lastSyncedAt    DateTime?
  syncError       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  worklistItem    WorklistItem         @relation(fields: [worklistItemId], references: [id], onDelete: Cascade)
  connection      CalendarConnection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([worklistItemId, provider])
  @@unique([provider, externalEventId])
  @@index([connectionId])
  @@index([syncStatus])
}
