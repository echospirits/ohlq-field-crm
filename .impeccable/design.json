  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Copper action for the next useful step; stable on hover.",
      "html": "<button class=\"ds-primary\" type=\"button\">Log Visit</button>",
      "css": ".ds-primary { display:inline-flex; align-items:center; justify-content:center; min-height:40px; padding:9px 13px; border:1px solid var(--action, #885731); border-radius:6px; background:var(--action, #885731); color:#fff; font-family:'Segoe UI Variable Text', 'Segoe UI', ui-sans-serif, system-ui, -apple-system, Roboto, Arial, sans-serif; font-size:.875rem; font-weight:600; line-height:1.2; cursor:pointer; transition:border-color 160ms ease, background-color 160ms ease, opacity 160ms ease; } .ds-primary:hover { background:var(--action-hover, #6d4426); border-color:var(--action-hover, #6d4426); } .ds-primary:focus-visible { outline: 2px solid var(--accent-2, #1b7567); outline-offset: 3px; } .ds-primary:disabled { background:var(--panel-2, #f2f4f3); border-color:var(--line, #d5ddda); color:var(--muted, #59656b); cursor:not-allowed; } @media(max-width:900px) { .ds-primary { min-height:44px; } } @media(prefers-reduced-motion:reduce) { .ds-primary { transition:none; } }"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet bordered surface for a supporting action.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Edit account</button>",
      "css": ".ds-secondary { display:inline-flex; align-items:center; justify-content:center; min-height:40px; padding:9px 13px; border:1px solid var(--line-strong, #7c878e); border-radius:6px; background:var(--panel, #fff); color:var(--text, #283138); font-family:'Segoe UI Variable Text', 'Segoe UI', ui-sans-serif, system-ui, -apple-system, Roboto, Arial, sans-serif; font-size:.875rem; font-weight:600; line-height:1.2; cursor:pointer; transition:border-color 160ms ease, background-color 160ms ease; } .ds-secondary:hover { background:var(--panel-2, #f2f4f3); border-color:var(--accent, #885731); } .ds-secondary:focus-visible { outline: 2px solid var(--accent-2, #1b7567); outline-offset: 3px; } .ds-secondary:disabled { background:var(--panel-2, #f2f4f3); border-color:var(--line, #d5ddda); color:var(--muted, #59656b); cursor:not-allowed; } @media(max-width:900px) { .ds-secondary { min-height:44px; } } @media(prefers-reduced-motion:reduce) { .ds-secondary { transition:none; } }"
    },
    {
      "name": "Link Button",
      "kind": "button",
      "refersTo": "button-link",
      "description": "Transparent accent action for an existing local workflow.",
      "html": "<button class=\"ds-link\" type=\"button\">Clear filters</button>",
      "css": ".ds-link { display:inline-flex; align-items:center; justify-content:center; min-height:40px; padding:9px 13px; border:0; border-radius:6px; background:transparent; color:var(--accent, #885731); font-family:'Segoe UI Variable Text', 'Segoe UI', ui-sans-serif, system-ui, -apple-system, Roboto, Arial, sans-serif; font-size:.875rem; font-weight:600; line-height:1.2; cursor:pointer; } .ds-link:hover { color:var(--theme-link, #885731); background:transparent; } .ds-link:focus-visible { outline: 2px solid var(--accent-2, #1b7567); outline-offset: 3px; } @media(max-width:900px) { .ds-link { min-height:44px; } }"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "Visible label, strong field border and readable mobile text.",
      "html": "<label class=\"ds-field-label\" for=\"ds-account-search\">Account search</label><input id=\"ds-account-search\" class=\"ds-field\" type=\"search\" placeholder=\"Find an account\">",
      "css": ".ds-field-label { display:block; color:var(--muted, #59656b); font-family:'Segoe UI Variable Text', 'Segoe UI', ui-sans-serif, system-ui, -apple-system, Roboto, Arial, sans-serif; font-size:13px; font-weight:700; } .ds-field { width:100%; min-height:40px; padding:9px 10px; border:1px solid var(--line-strong, #7c878e); border-radius:6px; background:var(--panel, #fff); color:var(--text, #283138); font-family:'Segoe UI Variable Text', 'Segoe UI', ui-sans-serif, system-ui, -apple-system, Roboto, Arial, sans-serif; font-size:.875rem; line-height:1.5; caret-color:var(--accent, #885731); } .ds-field::placeholder { color:var(--muted, #59656b); opacity:1; } .ds-field:focus-visible { outline: 2px solid var(--accent-2, #1b7567); outline-offset: 3px; } @media(max-width:900px) { .ds-field { min-height:44px; font-size:1rem; } }"
    },
    {
      "name": "Desktop Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Persistent Chalkboard navigation with a clearly selected destination.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a class=\"ds-nav-link\" href=\"#schedule\">My Schedule</a><a class=\"ds-nav-link\" aria-current=\"page\" href=\"#accounts\">Account Search</a><a class=\"ds-nav-link\" href=\"#worklist\">Worklist</a></nav>",
      "css": ".ds-nav { display:grid; gap:2px; padding:12px; background:#283138; font-family:'Segoe UI Variable Text', 'Segoe UI', ui-sans-serif, system-ui, -apple-system, Roboto, Arial, sans-serif; } .ds-nav-link { display:flex; align-items:center; min-height:36px; padding:8px 10px; border-radius:5px; color:#eff3f2; text-decoration:none; font-size:.8125rem; line-height:1.4; font-weight:500; transition:background-color 160ms ease, color 160ms ease; } .ds-nav-link:hover { color:#fff; background:#34434a; } .ds-nav-link[aria-current=\"page\"] { color:#b8eddf; background:#35584f; font-weight:650; } .ds-nav-link:focus-visible { outline:2px solid #76d5c3; outline-offset:3px; } @media(prefers-reduced-motion:reduce) { .ds-nav-link { transition:none; } }"
    },
    {
      "name": "Neutral Status Chip",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "A concise static label; operational variants use paired semantic colors.",
      "html": "<span class=\"ds-chip\">Unassigned</span>",
      "css": ".ds-chip { display:inline-flex; align-items:center; width:fit-content; min-height:28px; margin:2px; padding:3px 7px; border:1px solid transparent; border-radius:4px; background:var(--panel-2, #f2f4f3); color:var(--muted, #59656b); font-family:'Segoe UI Variable Text', 'Segoe UI', ui-sans-serif, system-ui, -apple-system, Roboto, Arial, sans-serif; font-size:.75rem; font-weight:600; line-height:1.5; }"
    },
    {
      "name": "Working Card",
      "kind": "card",
      "refersTo": "card",
      "description": "A distinct working area separated by a fine border without elevation.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">Next commitment</h2><p class=\"ds-card-copy\">Confirm the tasting date with the account contact.</p></section>",
      "css": ".ds-card { padding:16px; background:var(--panel, #fff); color:var(--text, #283138); border:1px solid var(--line, #d5ddda); border-radius:8px; box-shadow:none; font-family:'Segoe UI Variable Text', 'Segoe UI', ui-sans-serif, system-ui, -apple-system, Roboto, Arial, sans-serif; font-size:.9375rem; line-height:1.5; } .ds-card-title { margin:0 0 12px; font-size:1.125rem; font-weight:650; line-height:1.35; letter-spacing:-.01em; } .ds-card-copy { margin:0; } @media(max-width:900px) { .ds-card { padding:14px; } }"
    },
    {
      "name": "Comparison Table",
      "kind": "custom",
      "description": "Identity-first rows, shared headers and right-aligned tabular values.",
      "html": "<div class=\"ds-table-region\" role=\"region\" aria-label=\"Account comparison\" tabindex=\"0\"><table class=\"ds-table\"><thead><tr><th scope=\"col\">Account</th><th class=\"ds-number\" scope=\"col\">Bottles</th><th scope=\"col\">Next commitment</th></tr></thead><tbody><tr><th scope=\"row\"><a href=\"#account\">Example account</a></th><td class=\"ds-number\">128</td><td>Confirm tasting date</td></tr><tr><th scope=\"row\"><a href=\"#account-two\">Second example</a></th><td class=\"ds-number\">96</td><td>Review order</td></tr></tbody></table></div>",
      "css": ".ds-table-region { max-width:100%; overflow-x:auto; overscroll-behavior-x:contain; } .ds-table-region:focus-visible { outline: 2px solid var(--accent-2, #1b7567); outline-offset: 3px; } .ds-table { width:100%; border-collapse:collapse; background:var(--panel, #fff); color:var(--text, #283138); font-family:'Segoe UI Variable Text', 'Segoe UI', ui-sans-serif, system-ui, -apple-system, Roboto, Arial, sans-serif; font-size:.875rem; line-height:1.5; } .ds-table th,.ds-table td { padding:10px 12px; text-align:left; vertical-align:top; border-bottom:1px solid var(--line, #d5ddda); } .ds-table thead th { background:var(--panel-2, #f2f4f3); color:var(--muted-2, #46545a); font-size:.75rem; font-weight:650; } .ds-table tbody th { font-size:.875rem; font-weight:600; } .ds-table .ds-number { text-align:right; font-variant-numeric:tabular-nums; } .ds-table tbody tr:hover th,.ds-table tbody tr:hover td { background:var(--panel-2, #f2f4f3); } .ds-table a { color:var(--accent, #885731); text-underline-offset:3px; } .ds-table a:focus-visible { outline: 2px solid var(--accent-2, #1b7567); outline-offset: 3px; }"
    },
    {
      "name": "Supporting Disclosure",
