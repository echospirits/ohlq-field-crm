# Explicit application identity. Vercel deployments must set APP_ENV.
APP_ENV="development"
# Must match APP_ENV whenever DATABASE_URL is configured.
DATABASE_ENVIRONMENT="development"
# Safe display label only; never put a URL or secret here.
DATABASE_TARGET_ID="local-development"
# Exact hostname parsed from DATABASE_URL; required in production and test.
EXPECTED_DATABASE_HOST="localhost"

# Use a pooled Postgres connection for serverless runtime on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ohlq_crm?sslmode=require"

APP_BASE_URL="http://localhost:3000"
# Required in test so a bad URL mapping fails closed.
PRODUCTION_BASE_URL="https://crm.example.com"

# External side effects default enabled only in production. Set explicitly when needed.
EMAIL_SEND_ENABLED="false"
CALENDAR_SYNC_ENABLED="false"
CRON_JOBS_ENABLED="false"
OHLQ_IMPORT_ENABLED="false"
FILE_UPLOADS_ENABLED="false"
WEBHOOK_REGISTRATION_ENABLED="false"

# Vercel Blob object storage for uploaded visit photos.
BLOB_READ_WRITE_TOKEN=""
BLOB_ENVIRONMENT="development"

# Weekly digest email delivery.
RESEND_API_KEY=""
EMAIL_FROM="Echo Field CRM <crm@example.com>"
# Non-production sends require an override address. Disabled sends can optionally capture bodies in server logs.
EMAIL_OVERRIDE_RECIPIENT=""
EMAIL_CAPTURE_CONTENT="false"
CRON_SECRET=""

# Server-only Google Maps Geocoding API key. Browser Maps APIs are not required.
GOOGLE_MAPS_GEOCODING_API_KEY=""

# Per-user Google Calendar OAuth and encrypted token storage.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OAUTH_ENVIRONMENT="development"
# Optional; defaults to APP_BASE_URL + /api/calendar/google/callback.
GOOGLE_REDIRECT_URI=""
# Use a stable secret with at least 32 characters. Rotating it requires reconnecting calendars.
CALENDAR_TOKEN_ENCRYPTION_KEY=""

# One-time operator confirmations. Never set these persistently in Vercel.
ALLOW_DATABASE_RESET="false"
ALLOW_SCHEMA_PUSH="false"
STAGING_ADMIN_EMAIL="admin@example.test"
STAGING_ADMIN_PASSWORD=""

# Tenant/product defaults. Leave blank to use the Echo Spirits defaults in code.
TENANT_ID=""
TENANT_ENTITY_NAME=""
TENANT_APP_NAME=""
TENANT_DIGEST_NAME=""
TENANT_PRODUCT_LABEL=""
TENANT_PRODUCT_PLURAL_LABEL=""
TENANT_PRODUCT_FILTER_MODE=""
TENANT_OHLQ_VENDOR_IDS=""
TENANT_EXCLUDED_ITEM_CODES=""
TENANT_ITEM_CODES=""

# Esther Rum tenant example:
# TENANT_ID="esther-rum"
# TENANT_ENTITY_NAME="Esther Rum"
# TENANT_APP_NAME="Esther Rum CRM"
# TENANT_DIGEST_NAME="Esther Rum CRM"
# TENANT_PRODUCT_LABEL="Esther Rum"
# TENANT_PRODUCT_PLURAL_LABEL="Esther Rum items"
# TENANT_PRODUCT_FILTER_MODE="item-list"
# TENANT_OHLQ_VENDOR_IDS="Z90399001"
# TENANT_ITEM_CODES="3150B"
# SEED_ADMIN_EMAIL="cheers@echospirits.com"
# SEED_ADMIN_FIRST_NAME="Esther"
# SEED_ADMIN_LAST_NAME="Admin"
# SEED_ADMIN_PASSWORD=""

# OHLQ Annual Sales Summary export automation.
OHLQ_OPS_USERNAME=""
OHLQ_OPS_PASSWORD=""

# Optional for clean-browser/cloud runs if Microsoft allows non-interactive auth.
OHLQ_MICROSOFT_USERNAME=""
OHLQ_MICROSOFT_PASSWORD=""

# Reject unexpectedly sparse inventory exports before replacing current state. Defaults to 25.
OHLQ_INVENTORY_MIN_QUALIFYING_ROWS="25"

# Optional backfill override. Defaults to yesterday in America/New_York.
OHLQ_REPORT_DATE=""

# Optional raw row retention window for OHLQ report fact tables. Defaults to 30 days.
OHLQ_REPORT_RETENTION_DAYS="30"

# Optional cron catch-up controls. Defaults import up to 2 missing report dates across a 3-day window.
OHLQ_CRON_CATCHUP_DAYS="3"
OHLQ_CRON_MAX_REPORT_DATES="2"
# Optional scheduled refresh window. Production cron defaults to refreshing yesterday and two days ago.
OHLQ_CRON_REFRESH_DAYS="2"

# Lets the Data Status manual import button and Vercel cron queue the GitHub Actions cloud runner.
GITHUB_ACTIONS_DISPATCH_TOKEN=""
GITHUB_ACTIONS_REPOSITORY="echospirits/ohlq-field-crm"
GITHUB_ACTIONS_REF="main"
GITHUB_ACTIONS_OHLQ_WORKFLOW_ID="ohlq-annual-sales.yml"

# Optional local output path. Defaults to output/ohlq-downloads.
OHLQ_DOWNLOAD_DIR=""
OHLQ_HEADLESS=""
OHLQ_BROWSER_CHANNEL=""
OHLQ_USE_SERVERLESS_CHROMIUM=""

# Optional future integrations
EVENTBRITE_TOKEN=""
EVENTBRITE_ORGANIZATION_ID=""
NEXT_PUBLIC_APP_NAME="Echo Spirits Distilling Co."
